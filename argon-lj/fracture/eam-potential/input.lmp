# LAMMPS Input File
# Licensed under CC BY 4.0
# See more in "A Set of Materials-Science Tutorials for the LAMMPS Simulation Package: 2. Materials Science"
# By Simon Gravelle, Mark A. Tschopp, Jacob R. Gissinger, and Axel Kohlmeyer

# 1) Initialization
units           metal # Use metal units (distance in Å, time in ps, and energy in eV)
dimension       3 # three spatial dimensions
boundary        p p p # Apply periodic boundary conditions
atom_style      atomic # Treat atoms as simple particles without charge or molecular topology

# 2) System definition

lattice         fcc 4.049 origin 0.25 0.25 0.25 # Define an FCC lattice with lattice constant 4.049 Å and shift the lattice origin
region          box block 0 6 0 6 0 6 units lattice # Define a simulation box of 4 × 4 × 4 lattice units
create_box      1 box # Create the simulation box with one atom type
create_atoms    1 box # Fill the simulation box with atoms of type 1

# 3) Settings
pair_style      eam/alloy # Use the Embedded Atom Method (EAM) alloy potential
pair_coeff      *    *    Al_zhou.eam.alloy Al # Assign the aluminum EAM potential to atom type 1

# 4) Monitoring
thermo          100 # Output thermodynamic information every 100 timesteps
thermo_style    custom step temp etotal ke pe density pxx # Choose what information is printed

dump            viz      all      image 100 myimage-*.ppm type type shiny 0.1 box no 0.01 view 0 0 zoom 1 fsaa yes size 800 800
dump_modify     viz adiam 1 1 acolor 1 turquoise backcolor white

# 5) Run
velocity        all create 1 4928459 rot yes mom yes dist gaussian
fix             mynve    all      nve # Integrate the equations of motion
timestep        0.001 # Set the integration timestep to 0.005 in LJ reduced time units
fix             myber    all      temp/berendsen 1 1 0.1 # Thermostat at temperature 300 with time constant 0.1 ps

run             2500 # Equilibration run

fix             mydef    all      deform 1 x scale 1.5 remap v

run             20000 # Production run

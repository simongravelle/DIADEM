# Simple NVE argon simulation

units           lj # Use Lennard-Jones reduced units
dimension       3 # Perform the simulation in 3 spatial dimensions
atom_style      atomic # Atoms are treated as point particles without bonds or molecular topology
boundary        p p p # Use periodic boundary conditions

lattice         fcc 1 origin 0.25 0.25 0.25 # Define a fcc lattice
region          simbox block -5 5 -3 3 -3 3 # Define the simulation box from -20 to 20 in x, y, and z
create_box      1 simbox # Create a simulation box containing one atom type
create_atoms    1 region simbox # Create atoms on a lattice

lattice         none 1.0 # Overwrite previous lattice

mass            1    1.0 # Assign a mass to atom type 1 (mass = 1.0)
pair_style      lj/cut 4.0 # Use a Lennard-Jones pair potential with a cutoff distance of 4.0
pair_coeff      1    1    1.0 1.0 # Set Lennard-Jones parameters for atom type 1 (epsilon = 1.0 sigma = 1.0)

# minimize        1.0e-4 1.0e-6 100 1000 # reduce the initial energy of the system to present rise in temperature

velocity        all create 0.4 4928459 rot yes mom yes dist gaussian
fix             mynve    all      nve # Integrate the equations of motion
timestep        0.005 # Set the integration timestep to 0.005 in LJ reduced time units
fix             myber    all      temp/berendsen 0.4 0.4 10 # Thermostat at temperature 1 with time constant 10
fix             mydef    all      deform 1 x scale 1.5

thermo          100 # Print thermodynamic information in log
thermo_style    custom step temp etotal ke pe density pxx # Choose what information is printed

# Uncomment to generate images
dump            viz      all      image 500 myimage-*.ppm type type size 800 1400 zoom 1 shiny 0.5 fsaa yes view 0 0 box yes 0.005 axes no 0.0 0.0 center s 0.483725 0.510373 0.510373
dump_modify     viz pad 9 boxcolor white backcolor black adiam 1 1 acolor 1 cyan

run             50000
